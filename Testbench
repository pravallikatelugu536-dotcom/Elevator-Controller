`timescale 1ns/1ps

module tb_elevator_controller;

    reg clk;
    reg reset;

    reg [1:0] request;
    reg       req_valid;

    wire      motor_up;
    wire      motor_down;
    wire      door_open;

    wire [1:0] floor;

    // Instantiate elevator controller
    elevator_controller DUT (
        .clk(clk),
        .reset(reset),

        .request(request),
        .req_valid(req_valid),

        .motor_up(motor_up),
        .motor_down(motor_down),
        .door_open(door_open),

        .floor(floor)
    );

    // 10 ns clock
    always #5 clk = ~clk;

    // Request a floor
    task request_floor(input [1:0] floor_number);
    begin

        @(negedge clk);

        request  = floor_number;
        req_valid = 1'b1;

        @(posedge clk);

        #1;

        req_valid = 1'b0;

        $display(
            "Time=%0t | Request Floor=%0d | Current Floor=%0d | UP=%b DOWN=%b DOOR=%b",
            $time,
            floor_number + 1,
            floor + 1,
            motor_up,
            motor_down,
            door_open
        );

    end
    endtask

    initial begin

        $dumpfile("elevator.vcd");
        $dumpvars(0, tb_elevator_controller);

        clk       = 1'b0;
        reset     = 1'b1;
        request   = 2'b00;
        req_valid = 1'b0;

        // Reset
        #12;
        reset = 1'b0;

        // Request Floor 3
        request_floor(2'b10);

        // Allow elevator to move
        repeat (4) begin
            @(posedge clk);
            #1;

            $display(
                "Time=%0t | Floor=%0d | UP=%b DOWN=%b DOOR=%b",
                $time,
                floor + 1,
                motor_up,
                motor_down,
                door_open
            );
        end

        // Request Floor 1
        request_floor(2'b00);

        // Allow elevator to move
        repeat (4) begin
            @(posedge clk);
            #1;

            $display(
                "Time=%0t | Floor=%0d | UP=%b DOWN=%b DOOR=%b",
                $time,
                floor + 1,
                motor_up,
                motor_down,
                door_open
            );
        end

        #20;

        $finish;

    end

endmodule
